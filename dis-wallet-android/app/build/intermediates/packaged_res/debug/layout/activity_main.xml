<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DIS Wallet"
            android:textColor="#58A6FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Decentralized Identity Signing"
            android:textColor="#8B949E"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VENDOR SETUP"
            android:textColor="#58A6FF"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etVendorId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vendor ID (e.g. docs)"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:background="@drawable/input_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etVendorOrigin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vendor Origin (e.g. https://docs.example.com)"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:background="@drawable/input_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:inputType="textUri"/>

        <Button
            android:id="@+id/btnProvision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Provision Vendor Key"
            android:backgroundTint="#238636"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIGN CHALLENGE"
            android:textColor="#58A6FF"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etChallenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste vendor challenge JSON here"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:background="@drawable/input_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:gravity="top"/>

        <Button
            android:id="@+id/btnSign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign with DIS"
            android:backgroundTint="#1F6FEB"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E6EDF3"
            android:textSize="13sp"
            android:background="@drawable/input_background"
            android:padding="16dp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"
            android:minLines="4"/>

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Self-Test"
            android:backgroundTint="#6E40C9"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy Proof"
            android:backgroundTint="#30363D"
            android:textColor="#E6EDF3"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#3FB950"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>